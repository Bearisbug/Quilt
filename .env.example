# 仓库内开发用：复制为 .env（已 gitignore）。密钥值从 Bitwarden 取：bw get password <键名> >> .env
# 打包运行（npx quilt-canvas）不读这个文件，读 $QUILT_HOME/config.env（首次启动自动生成，同样的键名）。
DATABASE_URL=postgres://quilt:quilt@127.0.0.1:5439/quilt   # 留空 = 内置 PGlite（数据在 .data/db）；开发用 docker compose 的 Postgres 方便直接查库
API_PORT=3100
PREVIEW_PORT=3101
BIND_HOST=127.0.0.1                                      # 本地版只绑回环地址（ADR-016）；MCP 免鉴权的前提
WEB_ORIGIN=http://localhost:5173                         # 开发 = Vite；打包时由 API 托管静态前端，等于 API 地址
API_ORIGIN=http://localhost:3100
PREVIEW_ORIGIN=http://preview.localhost:3101            # 预览域只要与主站不同 origin（ADR-004）；打包时默认 http://127.0.0.1:3101
PREVIEW_SIGNING_SECRET=dev-preview-secret-change-me      # 预览 URL HMAC；打包时首次启动自动生成
QUILT_SECRETS_KEY=                                       # 设置页自填的通道 API Key 的加密主密钥（REQ-CORE-013）；任意口令，推荐 openssl rand -base64 32；未设则拒绝保存含密钥的通道。打包时首次启动自动生成
LLM_DRIVER=agent-sdk                                     # agent-sdk（本机 Claude 订阅）| anthropic（需 ANTHROPIC_API_KEY）| gemini（需 GEMINI_API_KEY）| stub
ANTHROPIC_API_KEY=                                       # LLM_DRIVER=anthropic 时必填；Bitwarden: ANTHROPIC_API_KEY
GEMINI_API_KEY=                                          # LLM_DRIVER=gemini 且走 AI Studio 计费时必填；Bitwarden: GEMINI_API_KEY
GEMINI_VERTEX=                                           # 置 1 走 Vertex AI 计费路径（不用 key，鉴权走 ADC）
GOOGLE_CLOUD_PROJECT=                                    # Vertex 路径必填：GCP 项目 ID（需启用 Vertex AI API 并绑定结算）
GOOGLE_CLOUD_LOCATION=global                             # Vertex 路径：区域，Gemini 3.x 用 global 或 us-central1
GOOGLE_APPLICATION_CREDENTIALS=                          # Vertex 路径：服务账号 JSON 的本机绝对路径（角色 Vertex AI User）；本机开发也可改用 gcloud auth application-default login
QUILT_MODEL=claude-sonnet-5                              # 出屏模型；gemini 驱动用 gemini-3.8-flash（实测最稳）
QUILT_MODEL_INITIAL=claude-sonnet-5                      # 初始多屏可切 claude-opus-5
LLM_STUB=                                                # 测试用：503 | fixture（仅 LLM_DRIVER=stub 时生效）
QUILT_CLAUDE_SESSIONS_DIR=                               # 测试用：替换 Claude Code 会话登记处（默认 ~/.claude/sessions；投递到本机会话按这里的登记文件找 socket）
STORAGE_DRIVER=fs                                        # fs（本地 .data/objects）| s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=                                        # Bitwarden: QUILT_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=                                    # Bitwarden: QUILT_S3_SECRET_ACCESS_KEY
SCREENSHOT_BROWSER_CHANNEL=msedge                        # 留空 = 依次试本机 Chrome → Edge → Playwright 自带 Chromium
